{
  "format": "vimfu-example-def",
  "version": 1,
  "id": "editing.line-motions",
  "title": "0 ^ $",
  "summary": "Three flavors of line start/end.",
  "topic": "editing.line-motions",
  "content": "    hello world",
  "cursor": [
    0,
    8
  ],
  "frames": [
    {},
    {
      "actions": [
        {
          "keys": "0"
        }
      ],
      "caption": "{key:0} — column 0 (literal start).",
      "keys": "0"
    },
    {
      "actions": [
        {
          "keys": "^"
        }
      ],
      "caption": "{key:^} — first non-blank.",
      "keys": "^"
    },
    {
      "actions": [
        {
          "keys": "$"
        }
      ],
      "caption": "{key:$} — end of line.",
      "narration": "Use ^ when you want code, 0 when you want column zero, $ to land on the last char.",
      "keys": "$"
    }
  ]
}
