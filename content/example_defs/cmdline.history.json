{
  "format": "vimfu-example-def",
  "version": 1,
  "id": "cmdline.history",
  "title": "q:",
  "summary": "Command-line history as an editable buffer.",
  "topic": "cmdline.history-window",
  "content": "practice file",
  "cursor": [
    0,
    0
  ],
  "nvim_args": [
    "-i",
    "NONE",
    "-c",
    "call histadd('cmd', 'w')",
    "-c",
    "call histadd('cmd', '%s/foo/bar/g')",
    "-c",
    "call histadd('cmd', 'make')"
  ],
  "frames": [
    {
      "caption": "q: — opens the history window."
    },
    {
      "actions": [
        {
          "keys": "kk"
        }
      ],
      "caption": "Pick any line, edit it, Enter to run.",
      "keys": "kk"
    }
  ],
  "prep": [
    {
      "keys": "q:"
    }
  ]
}
