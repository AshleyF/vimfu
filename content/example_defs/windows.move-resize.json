{
  "format": "vimfu-example-def",
  "version": 1,
  "id": "windows.move-resize",
  "title": "{key:Ctrl-W}{key:=} balances splits",
  "summary": "Resize and balance windows after a split.",
  "topic": "windows.move-resize",
  "content": [
    "pane"
  ],
  "cursor": [
    0,
    0
  ],
  "filename": "main.txt",
  "nvim_args": [
    "-c",
    "set noshowmode"
  ],
  "frames": [
    {},
    {
      "actions": [
        {
          "keys": "\u0017"
        },
        {
          "keys": "v"
        }
      ],
      "keys": "Ctrl-W v",
      "caption": "Two side-by-side windows."
    },
    {
      "actions": [
        {
          "keys": "\u0017"
        },
        {
          "keys": "10>"
        },
        {
          "keys": "\u0017"
        },
        {
          "keys": "="
        }
      ],
      "keys": "Ctrl-W 10>  Ctrl-W =",
      "caption": "Widen, then {key:Ctrl-W}{key:=} balances both.",
      "narration": "Capital {key:H}/{key:J}/{key:K}/{key:L} after {key:Ctrl-W} move the *window* to an edge; {key:+}/{key:-} grow and shrink."
    }
  ]
}
