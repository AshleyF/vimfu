{
  "format": "vimfu-example-def",
  "version": 1,
  "id": "search.pattern",
  "title": "/word and n / N",
  "summary": "Forward search, then jump through hits.",
  "topic": "search.pattern",
  "content": [
    "the cat",
    "ran past",
    "the cat",
    "and away"
  ],
  "cursor": [
    0,
    0
  ],
  "nvim_args": [
    "-c",
    "set hlsearch"
  ],
  "frames": [
    {},
    {
      "actions": [
        {
          "type": "/cat"
        }
      ],
      "caption": "/ shows search prompt at the bottom.",
      "keys": "/cat"
    },
    {
      "actions": [
        "enter"
      ],
      "caption": "{key:Enter} — first match highlighted.",
      "keys": "Enter"
    },
    {
      "actions": [
        {
          "keys": "n"
        }
      ],
      "caption": "{key:n} — next match.",
      "narration": "N goes back. // repeats with the same pattern; ? searches backward.",
      "keys": "n"
    }
  ]
}
