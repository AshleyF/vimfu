{
  "format": "vimfu-example-def",
  "version": 1,
  "id": "survival.open-save-quit",
  "title": ":w and :q",
  "summary": "Save and quit from the Ex prompt.",
  "topic": "survival.open-save-quit",
  "content": [
    "greetings",
    "from vi"
  ],
  "cursor": [
    1,
    0
  ],
  "filename": "hello.txt",
  "frames": [
    {
      "caption": "Modified buffer ([+])."
    },
    {
      "actions": [
        {
          "ex": "w"
        }
      ],
      "caption": ":w writes the file.",
      "narration": "Status loses [+]; the file is on disk. :q would now leave Vim.",
      "keys": ":w"
    }
  ],
  "prep": [
    {
      "keys": "A"
    },
    {
      "type": "m"
    },
    "escape"
  ]
