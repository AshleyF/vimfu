{
  "format": "vimfu-example-def",
  "version": 1,
  "id": "macros.record-play",
  "title": "qa ... q  then  @a",
  "summary": "Record once, play forever.",
  "topic": "macros.record-play",
  "content": [
    "one",
    "two",
    "three"
  ],
  "cursor": [
    0,
    0
  ],
  "frames": [
    {
      "actions": [
        {
          "keys": "qa"
        }
      ],
      "caption": "{key:q}{key:a} — start recording into a.",
      "keys": "qa"
    },
    {
      "actions": [
        {
          "keys": "I"
        },
        {
          "type": "1. "
        },
        "escape"
      ],
      "caption": "Prefix with '1. '.",
      "keys": "I1. Esc"
    },
    {
      "actions": [
        {
          "keys": "j"
        },
        {
          "keys": "0"
        }
      ],
      "caption": "Move to next line (recorded).",
      "keys": "j0"
    },
    {
      "actions": [
        {
          "keys": "q"
        }
      ],
      "caption": "{key:q} — stop recording.",
      "keys": "q"
    },
    {
      "actions": [
        {
          "keys": "@a"
        },
        {
          "keys": "@a"
        }
      ],
      "caption": "@a twice — replays on the next two lines.",
      "narration": "Macros are just register contents. Open the register, edit it, paste it — they're text.",
      "keys": "@a @a"
    }
  ]
}
