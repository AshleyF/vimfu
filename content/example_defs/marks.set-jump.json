{
  "format": "vimfu-example-def",
  "version": 1,
  "id": "marks.set-jump",
  "title": "ma and 'a",
  "summary": "Set a mark, jump back later.",
  "topic": "marks.local-global",
  "content": [
    "chapter one",
    "...content...",
    "chapter two",
    "..."
  ],
  "cursor": [
    0,
    0
  ],
  "frames": [
    {},
    {
      "actions": [
        {
          "keys": "ma"
        }
      ],
      "caption": "{key:m}{key:a} — mark 'a' set at this line.",
      "keys": "ma"
    },
    {
      "actions": [
        {
          "keys": "2j"
        }
      ],
      "caption": "Wandered to chapter two.",
      "keys": "2j"
    },
    {
      "actions": [
        {
          "keys": "'a"
        }
      ],
      "caption": "{key:'}{key:a} — jumped back to mark 'a'.",
      "narration": "Lowercase marks are file-local; uppercase marks are global (jump across files).",
      "keys": "'a"
    }
  ]
}
