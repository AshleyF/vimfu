  "setup": [
    {
      "comment": "Kill any stale tmux sessions"
    },
    {
      "line": "tmux kill-server 2>/dev/null; true"
    },
    {
      "comment": "Set vi mode keys for copy mode"
    },
    {
      "line": "printf 'set -g mode-keys vi\n' > ~/.tmux.conf"
    },
    {
      "comment": "Set TERM for proper color support"
    },
    {
      "line": "export TERM=xterm-256color"
    },
    {
      "comment": "Prepare workspace"
    },
    {
      "line": "export VIMFU_REPO=\"$PWD\""
    },
    {
      "line": "mkdir -p ~/vimfu && cd ~/vimfu"
    },
    {
      "writeFile": "flight.py",
      "content": "def launch_rocket(fuel):\n    if fuel < 50:\n        abort(\"low fuel\")\n    ignite(fuel)\n    climb(altitude=100)\n    orbit()\n\ndef check_systems():\n    nav = ping(\"nav\")\n    comms = ping(\"comms\")\n    return nav and comms\n\ndef begin_mission():\n    check_systems()\n    launch_rocket(fuel=100)\n    transmit(\"orbit achieved\")\n\nbegin_mission()\n"
    },
    {
      "line": "clear"
    },
    {
      "comment": "Launch tmux"
    },
    {
      "line": "tmux"
    },
    {
      "waitForScreen": "[0]",
      "timeout": 30.0
    },
    {
      "waitForScreen": "\"vimfu\"",
      "timeout": 30.0
    },
    {
      "comment": "Open the document before recording"
    },
    {
      "line": "nvim -u \"$VIMFU_REPO/shellpilot/nvim/init.vim\" flight.py"
    },
    {
      "waitForScreen": "launch_rocket",
      "timeout": 30.0
    },
    {
      "waitForScreen": "flight.py",
      "timeout": 30.0
    },
    {
      "comment": "Put the pane cursor near the bottom so upward copy-mode motions are visible"
    },
    {
      "keys": "G"
    }
  ],
